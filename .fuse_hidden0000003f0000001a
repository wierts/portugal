  <style>
    .rdetail-intro { background: var(--cream); padding: 2.5rem 0 2rem; }
    .back-link { display: inline-flex; align-items: center; gap: .4rem; color: var(--azul); font-weight: 600; text-decoration: none; margin-bottom: 1.25rem; }
    .back-link:hover { color: var(--terra); }
    .rdetail-header {
      display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
    }
    .rdetail-dag-badge {
      background: var(--terra); color: #fff; font-size: .75rem; font-weight: 700;
      letter-spacing: .05em; text-transform: uppercase; padding: .35rem .85rem; border-radius: 2px;
    }
    .rdetail-header h1 { font-family: var(--serif); font-size: 2.1rem; color: var(--dark); margin: 0; }
    .rdetail-city { color: var(--muted); font-size: .95rem; margin-top: .35rem; }

    .rdetail-body { padding: 2.5rem 0 4rem; }
    .rdetail-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem; align-items: start; }
    @media (max-width: 860px) { .rdetail-grid { grid-template-columns: 1fr; } }

    .specialiteit-box {
      border-left: 4px solid var(--terra); background: #fef5f0; padding: .9rem 1.1rem;
      border-radius: 0 var(--radius) var(--radius) 0; margin-bottom: 1.5rem;
    }
    .specialiteit-box strong { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--terra); margin-bottom: .3rem; }
    .specialiteit-box p { margin: 0; font-size: .97rem; color: var(--text); }
    .rdetail-desc { color: var(--text); line-height: 1.75; margin-bottom: 1.5rem; font-size: 1rem; }
    .tip-box {
      border-left: 4px solid var(--gold); background: #fffbf0; padding: .75rem 1.1rem;
      border-radius: 0 var(--radius) var(--radius) 0; font-size: .9rem; color: var(--muted); margin-bottom: 1.5rem;
    }
    .rdetail-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.75rem; }
    .rdetail-chip {
      background: var(--sand); border: 1px solid var(--border); border-radius: 2rem;
      font-size: .8rem; color: var(--text); padding: .3rem .85rem;
    }
    .rdetail-btns { display: flex; gap: .75rem; flex-wrap: wrap; }

    .review-card {
      background: var(--white); border: 1px solid var(--border); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm); padding: 1.75rem;
    }
    .review-card h2 {
      font-family: var(--serif); font-size: 1.2rem; color: var(--dark); margin: 0 0 1rem 0;
      display: flex; align-items: center; gap: .5rem;
    }
    .review-score {
      display: flex; align-items: baseline; gap: .5rem; margin-bottom: .25rem;
    }
    .review-score .num { font-family: var(--serif); font-size: 2.2rem; color: var(--terra); font-weight: 700; }
    .review-score .max { font-size: 1rem; color: var(--muted); }
    .review-meta { font-size: .82rem; color: var(--muted); margin-bottom: 1.1rem; }
    .review-summary { font-size: .92rem; line-height: 1.65; color: var(--text); margin-bottom: 1.25rem; }
    .review-source-note { font-size: .78rem; color: var(--muted); margin-top: 1rem; font-style: italic; }
    .review-unavailable { font-size: .9rem; color: var(--muted); font-style: italic; margin-bottom: 1rem; }
    .review-warning {
      border-left: 4px solid var(--terra); background: #fef5f0; padding: .7rem .9rem;
      border-radius: 0 var(--radius) var(--radius) 0; font-size: .82rem; color: var(--text); margin-bottom: 1.1rem;
