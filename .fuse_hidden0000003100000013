    .specialiteit-box strong { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--terra); margin-bottom: .3rem; }
    .specialiteit-box p { margin: 0; font-size: .97rem; color: var(--text); }
    .rdetail-desc { color: var(--text); line-height: 1.75; margin-bottom: 1.5rem; font-size: 1rem; }
    .tip-box {
      border-left: 4px solid var(--gold); background: #fffbf0; padding: .75rem 1.1rem;
      border-radius: 0 var(--radius) var(--radius) 0; font-size: .9rem; color: var(--muted); margin-bottom: 1.5rem;
    }
    .rdetail-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.75rem; }
    .rdetail-chip {
      background: var(--sand); border: 1px solid var(--border); border-radius: 2rem;
      font-size: .8rem; color: var(--text); padding: .3rem .85rem;
